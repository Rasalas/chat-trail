{
  "name": "chat-trail",
  "version": "0.2.1",
  "private": true,
  "description": "Local-first browser extension for exporting AI chat conversations with evidence packs.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "dev": "sh -c 'vite build --watch & vite build --watch --config vite.content.config.ts & wait'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "probe:build": "esbuild scripts/verify-scroll.ts --bundle --format=iife --outfile=dist/verify-scroll.js"
  },
  "keywords": [
    "browser-extension",
    "chat-export",
    "ai",
    "evidence"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.0.309",
    "eslint": "^10.9.0",
    "happy-dom": "^20.11.6",
    "jsdom": "^30.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.3.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "dompurify": "^3.4.14"
  }
}
