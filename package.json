{
  "name": "chat-trail",
  "version": "0.1.2",
  "private": true,
  "description": "Local-first browser extension for exporting AI chat conversations with evidence packs.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "keywords": [
    "browser-extension",
    "chat-export",
    "ai",
    "evidence"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.0.309",
    "eslint": "^10.9.0",
    "happy-dom": "^20.11.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.3.4",
    "vitest": "^4.1.11"
  }
}
