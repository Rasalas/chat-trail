{
  "name": "chat-trail",
  "version": "0.1.2",
  "private": true,
  "description": "Local-first browser extension for exporting AI chat conversations with evidence packs.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
