    "browser-extension",
    "chat-export",
    "ai",
    "evidence"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.309",
    "typescript": "^5.8.3",
    "vite": "^6.3.4"
  }
}
