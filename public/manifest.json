{
  "manifest_version": 3,
  "name": "Chat Trail",
  "version": "0.1.0",
  "description": "Export AI chat conversations locally as Markdown, JSON, HTML, or an evidence ZIP.",
  "action": {
    "default_title": "Chat Trail",
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-loader.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "downloads", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["src/review/index.html", "assets/*.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
